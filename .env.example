# Supabase Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_RELEASE_SHA=local-build-or-ci-git-sha
VITE_RUM_SAMPLE_RATE=0.25
# Diagnostic-only: production security smoke must leave this false/unset.
SECURITY_ALLOW_MISSING_TABLES=false

# External API Keys
# Chỉ dùng khi cấu hình Supabase Edge Functions; không đổi thành VITE_*.
SERPAPI_KEY=your-serpapi-key-here
TRAVELPAYOUTS_TOKEN=your-optional-travelpayouts-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-key
ALERT_FROM_EMAIL=FlyCheap Alerts <alerts@example.com>
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
PUBLIC_SITE_URL=http://localhost:5173
UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret
INTERNAL_FUNCTION_SECRET=replace-with-another-long-random-secret
DEPLOYED_COMMIT=git-sha-set-by-ci
RATE_LIMIT_SALT=replace-with-at-least-16-random-characters
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=localhost,your-production-domain.example

# Real-hot-deal live loop
TARGET_DEALS=1000
PIPELINE_MAX_CYCLES=48
SCAN_ROUTE_BATCH_COUNT=12
SCAN_CACHE_TTL_HOURS=72
SCAN_HOT_ROUTE_CACHE_TTL_HOURS=6
FLIGHT_PROVIDER=serpapi
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CURRENCY=VND
HOT_DEAL_SCORE=80
HOT_DEAL_DISCOUNT=20
HOT_DEAL_CONFIDENCE=0.65
PIPELINE_ALLOW_BELOW_TARGET=false
AI_EXPLANATION_BATCH_LIMIT=20
ANALYZE_FLIGHT_LIMIT=300

# Production truth gate. Use only sources approved for the deployed contract.
LIVE_LAUNCH_ROUTES=HAN-BKK,HAN-SIN,HAN-ICN
APPROVED_LIVE_SOURCES=approved_provider_name
APPROVED_BOOKING_HOSTS=provider.example,aviasales.com,travelpayouts.com,google.com
