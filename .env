# ============================================
# FlyCheap AI — Environment Variables
# ============================================
# Điền thông tin Supabase project của bạn vào đây
# Lấy từ: https://app.supabase.com → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Email Confirmation (Resend - Free tier: 3k emails/month)
# Đăng ký miễn phí tại: https://resend.com
# ============================================
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# ============================================
# Background Flight Scanner (Edge Function)
# Dùng để scan giá thật từ Kiwi/Amadeus API
# ============================================
# FLIGHT_API_KEY=your-kiwi-or-amadeus-key
